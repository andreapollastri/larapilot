connector: file

settings:
  effort: STANDARD
  backlog: STANDARD
  git_mode: GITFLOW
  testing: NORMAL
  # Account mode — NONE, FREELANCE, or COMPANY. Unlocks /larapilot/economics.
  account: NONE
  auto_approve: false
  lucille: true
  # Decision journal + regression guard (.larapilot/decisions.yaml) — ON by default.
  decision_log: true
  # Per spec/task file + line-range history (.larapilot/code-history.yaml) — OFF by default.
  code_history: false
  # Semver release ledger + Gitflow release branches — OFF by default.
  release_mode: false
  # Living project documentation (_project_docs/) — OFF by default.
  project_docs: false
  # Internal feedback on dashboard/API/spec-comment — OFF by default.
  comments: false
  dashboard_auth: false
  # Require LARAPILOT_API_TOKEN on every /larapilot/api/* request — OFF by default.
  api_auth: false
  # Run andreapollastri/checkpoint (static security scan) in /larapilot-review + pre-ship — OFF by default.
  security_scan: false
  github: false
  gitlab: false
  bitbucket: false
  azure: false
  notifications: false
  notify_slack: false
  notify_discord: false
  notify_telegram: false

# External frontend repo — absolute path in LARAPILOT_FRONTEND_REPO_PATH (.env); stack here.
frontend:
  stack: null

paths:
  prd: .larapilot/docs/PRD.md
  mockups: .larapilot/mockups/
  test_results: .larapilot/docs/test-results/
  review: .larapilot/docs/review/
  security: .larapilot/docs/security/
  launch: .larapilot/docs/launch/
  support: .larapilot/docs/support/
  client_materials: .larapilot/client-materials/
  legacy: .larapilot/legacy/
  research: .larapilot/research/
  design_systems: .larapilot/design-systems/
  internal_feedback: .larapilot/internal-feedback/
  releases: .larapilot/releases.yaml
  project_docs: _project_docs/
  custom_skills: .larapilot/skills/
  economics: .larapilot/economics.yaml

workflow:
  statuses:
    todo: TODO
    planned: PLANNED
    in_progress: IN PROGRESS
    review: REVIEW
    done: DONE

file:
  backlog: .larapilot/backlog.yaml
  specs: .larapilot/specs/
  planning: .larapilot/plans/
