connector: file

settings:
  effort: STANDARD
  backlog: STANDARD
  git_mode: GITFLOW
  testing: NORMAL
  # Account mode — NONE, FREELANCE, or COMPANY. Unlocks /larapilot/economics.
  account: NONE
  auto_approve: false
  lucille: true
  # Decision journal + regression guard (.larapilot/decisions.yaml) — ON by default.
  decision_log: true
  # Per spec/task file + line-range history (.larapilot/code-history.yaml) — OFF by default.
  code_history: false
  # Semver release ledger + Gitflow release branches — OFF by default.
  release_mode: false
  # Living project handbook (.larapilot/docs/handbook/) — OFF by default.
  project_docs: false
  # Prior-art search for existing open-source / packaged solutions at inception — ON by default.
  prior_art: true
  # Workflow hooks (.larapilot/hooks.yaml) — your commands and skills on the loop's transitions — OFF by default.
  hooks: false
  # Internal feedback on dashboard/API/spec-comment — OFF by default.
  comments: false
  dashboard_auth: false
  # Require LARAPILOT_API_TOKEN on every /larapilot/api/* request — OFF by default.
  api_auth: false
  # Run andreapollastri/checkpoint (static security scan) in /larapilot-review + pre-ship — OFF by default.
  security_scan: false
  aikido: false
  errors: false
  boogle: false
  errors_provider: ''
  github: false
  gitlab: false
  bitbucket: false
  azure: false
  notifications: false
  notify_slack: false
  notify_discord: false
  notify_telegram: false

# External frontend repo — absolute path in LARAPILOT_FRONTEND_REPO_PATH (.env); the rest here.
# projects: workspace projects of this product in a monorepo (Nx, Angular CLI, pnpm/yarn workspaces, Turborepo).
# mode: driven (Larapilot writes the frontend) | handoff (the frontend team builds from larapilot:frontend-brief).
frontend:
  stack: null
  projects: []
  mode: driven

paths:
  prd: .larapilot/docs/PRD.md
  mockups: .larapilot/mockups/
  test_results: .larapilot/docs/test-results/
  review: .larapilot/docs/review/
  security: .larapilot/docs/security/
  launch: .larapilot/docs/launch/
  support: .larapilot/docs/support/
  dev_docs: .larapilot/docs/devs/
  client_materials: .larapilot/client-materials/
  legacy: .larapilot/legacy/
  research: .larapilot/research/
  design_systems: .larapilot/design-systems/
  internal_feedback: .larapilot/internal-feedback/
  usage: .larapilot/usage/
  choices: .larapilot/choices.yaml
  schedule: .larapilot/usage/schedule.yaml
  decisions: .larapilot/decisions.yaml
  code_history: .larapilot/code-history.yaml
  releases: .larapilot/releases.yaml
  project_docs: .larapilot/docs/handbook/
  custom_skills: .larapilot/skills/
  economics: .larapilot/economics.yaml
  economics_snapshot: .larapilot/economics.snapshot.yaml
  economics_quote: .larapilot/docs/quote.md
  economics_market: .larapilot/economics.market.yaml
  frontend_briefs: .larapilot/docs/frontend-briefs/
  upgrades: .larapilot/docs/upgrades/
  hooks: .larapilot/hooks.yaml

workflow:
  statuses:
    todo: TODO
    planned: PLANNED
    in_progress: IN PROGRESS
    review: REVIEW
    done: DONE

file:
  backlog: .larapilot/backlog.yaml
  specs: .larapilot/specs/
  planning: .larapilot/plans/
