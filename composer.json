{
    "name": "andreapollastri/larapilot",
    "description": "Spec-driven AI product workflow for Laravel — discovery, backlog, planning, implementation, and review via Laravel Boost.",
    "keywords": [
        "laravel",
        "ai",
        "boost",
        "mcp",
        "spec-driven",
        "product-development"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Andrea Pollastri",
            "email": "scrivi@andreapollastri.net"
        }
    ],
    "support": {
        "issues": "https://github.com/andreapollastri/larapilot/issues",
        "source": "https://github.com/andreapollastri/larapilot"
    },
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "laravel/boost": "^1.0|^2.0",
        "symfony/yaml": "^7.0|^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.6|^11.0",
        "pestphp/pest": "^3.8|^4.1",
        "phpstan/phpstan": "^2.1"
    },
    "suggest": {
        "andreapollastri/checkpoint": "Static Laravel security scanner. Install as --dev and set settings.security_scan=YES to fold `checkpoint:scan` findings into /larapilot-review and the pre-ship gate."
    },
    "autoload": {
        "psr-4": {
            "Larapilot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Larapilot\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Larapilot\\LarapilotServiceProvider"
            ]
        },
        "larapilot": {
            "quality": {
                "larastan_level_min": 5,
                "tools": [
                    "larastan/larastan",
                    "laravel/pint"
                ]
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --format agent",
        "analyse": "phpstan analyse --memory-limit=1G"
    }
}
